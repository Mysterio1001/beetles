{
  "name": "beetle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:foundation": "node --test tests/foundation/*.test.js",
    "lint": "eslint src tests vite.config.js eslint.config.js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{js,vue,scss,json}\" \"tests/**/*.js\" \"*.{js,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,scss,json}\" \"tests/**/*.js\" \"*.{js,json,html}\""
  },
  "dependencies": {
    "@fontsource/noto-sans-tc": "^5.2.6",
    "@fontsource/yuji-boku": "^5.2.6",
    "@iconify-icons/simple-icons": "^1.2.74",
    "@iconify/vue": "^5.0.0",
    "@mysterio1001/toolkit": "^1.4.0",
    "lucide-vue-next": "^0.509.0",
    "marked": "^15.0.12",
    "vue": "^3.5.13",
    "vue-i18n": "^12.0.0-alpha.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@vitejs/plugin-vue": "^5.2.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.3.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "sass": "^1.87.0",
    "vite": "^6.3.1"
  }
